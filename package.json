{
  "name": "wasm-cad-viewer",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/verify-build.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "preview": "vite preview",
    "deploy": "pnpm run deploy:production",
    "deploy:production": "pnpm run build && wrangler pages deploy dist --project-name wasm-cad-viewer --branch main"
  },
  "dependencies": {
    "@mlightcad/libdxfrw-web": "^0.1.0",
    "@mlightcad/libredwg-web": "^0.7.1",
    "dxf-viewer": "^1.0.47",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^7.3.3",
    "wrangler": "^4.90.1"
  }
}
